{
  "name": "computer-system",
  "version": "0.0.0",
  "private": true,
  "description": "ComputerCraft-inspired programmable computers for Minecraft Bedrock Edition",
  "type": "module",
  "scripts": {
    "build": "node tools/build.mjs",
    "deploy": "node tools/deploy.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "vitest run",
    "test:bds": "npm run build && node tools/bds-probe-runner.mjs",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "validate": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@minecraft/server": "2.8.0",
    "@minecraft/server-ui": "2.1.0",
    "@minecraft/vanilla-data": "1.26.33",
    "@types/node": "26.1.1",
    "eslint": "10.7.0",
    "eslint-plugin-minecraft-linting": "2.0.12",
    "esbuild": "0.28.1",
    "globals": "17.7.0",
    "prettier": "3.9.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.63.0",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=24"
  }
}
